# Response headers, read by Cloudflare Pages at deploy time.
#
# This file is the whole reason Cloudflare is worth moving to. GitHub Pages
# cannot send custom headers at all, so on that host the policy has to live in a
# <meta> tag — which works for most of it, but browsers ignore frame-ancestors
# there. That one is the anti-clickjacking rule, and it is the rule that matters
# the day this site has a signing UI attached to it.
#
# Harmless on GitHub Pages: it just serves the file as static text and ignores
# it. The <meta> policy in layout.tsx stays either way, so the site is never
# unprotected on whichever host is answering.

/*
  # Same policy as the meta tag, plus the two directives a meta tag cannot carry.
  #
  # connect-src carries the Robinhood Chain RPC origin because the borrow screen
  # reads the lending contract. This file is plain text to Cloudflare — no build
  # step touches it — so it is the one copy that cannot be derived from
  # src/lib/rpc.ts. `npm run check:csp` compares the two, because them drifting
  # apart fails in the worst possible way: the meta policy permits the call, this
  # header blocks it, and only the deployed site is broken.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://*.walletconnect.com https://*.web3modal.org https://imagedelivery.net; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://rpc.mainnet.chain.robinhood.com wss://*.walletconnect.org wss://*.walletconnect.com https://*.walletconnect.org https://*.walletconnect.com https://*.web3modal.org; frame-src 'self' https://*.walletconnect.org https://*.walletconnect.com; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  # X-Frame-Options is redundant next to frame-ancestors for a current browser,
  # and is here for the older ones that only understand this.
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  # Nothing here needs a camera, a location or a payment handler. Denying them
  # outright means an injected script cannot ask on the site's behalf.
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  # Two years, subdomains included, so app.cykablyat.vip is covered before it
  # exists. Deliberately not "preload": that submits the domain to a list baked
  # into browsers, and getting off it takes months.
  Strict-Transport-Security: max-age=63072000; includeSubDomains

# The HTML document must never be served stale. It carries the CSP meta tag and
# the references to the hashed bundles, so a cached copy pins an old policy and
# an old app on a returning visitor — which is exactly how a fix can ship and a
# phone keep showing the version from before it. Revalidate on every load; the
# bytes are still held and an unchanged document comes back as a bodyless 304.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Every filename under here is content-hashed by the build, so a change ships a
# new name rather than a new version of an old name. Nothing needs revalidating.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The opposite case. Everything in public/ is copied verbatim by the static
# export, so the mascot and the share card keep the same URL when the art
# inside them changes — a repaint ships new bytes under an old name. Without a
# rule here they fall through to whatever the CDN and the browser decide, and a
# returning visitor can be handed last month's artwork indefinitely.
#
# max-age=0 with must-revalidate is not "do not cache": the bytes are still
# held, the client just asks "changed?" first and gets a bodyless 304 when they
# have not. One conditional request is the right price for art that must not go
# stale on the day it is updated.
/assets/*
  Cache-Control: public, max-age=0, must-revalidate

/og.png
  Cache-Control: public, max-age=0, must-revalidate
